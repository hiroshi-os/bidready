# Copy to .env. Every secret stays here. Nothing in this file is a real credential.

# sqlite for a laptop demo, postgres in docker-compose
DATABASE_URL=sqlite:///./data/bidready.db

DATA_DIR=./data

# mock | ollama | openai
# mock runs the full graph with a deterministic extractor. No model call, no key.
LLM_PROVIDER=mock
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434

# hash | sentence-transformers
# hash is a lexical feature-hash into FAISS so the vector path runs offline.
# sentence-transformers uses all-MiniLM-L6-v2 (install the local extra).
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# lexical | cross-encoder
RERANKER=lexical
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# v1 recalls more clauses. v2 keeps only modal + qualification cues.
PROMPT_VERSION=v1

# Notifications. Both are optional. Unset means the run records a stub row and does not send.
WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_TO=

# Optional. bidready runs with this empty. See bidready.tenderlens for the JSON contract.
TENDERLENS_BASE_URL=

# local | s3
DOCUMENT_STORE=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
